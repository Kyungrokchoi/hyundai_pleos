# API base as seen from the passenger's browser (a phone on the LAN cannot reach "localhost").
# Empty: derived at runtime as <current-host>:8000/api/v1.
NEXT_PUBLIC_API_BASE=
# Playwright e2e only.
E2E_API_BASE=http://127.0.0.1:8010/api/v1
E2E_WEB_BASE=http://127.0.0.1:3100
# `next dev` only: comma-separated hostnames allowed to load dev assets, e.g. your PC's LAN IP.
ALLOWED_DEV_ORIGINS=
