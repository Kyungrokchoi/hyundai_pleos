{
  "name": "moata-passenger-web",
  "version": "0.1.0",
  "private": true,
  "description": "MOATA passenger companion web app (Korean, mobile-first)",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p e2e/tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:api": "openapi-typescript ../contracts/openapi.yaml -o src/api/schema.d.ts --default-non-nullable false"
  },
  "dependencies": {
    "next": "16.4.4",
    "pretendard": "1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.4",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
