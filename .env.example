# Copy to backend/.env (never commit the real file). All values below are dev defaults.
MOATA_DATABASE_URL=sqlite:///./moata.db
# PostgreSQL: MOATA_DATABASE_URL=postgresql+psycopg://moata:CHANGE_ME@127.0.0.1:5432/moata
MOATA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Add your LAN origin when testing from a phone, e.g. http://192.168.0.10:3000 (no wildcard)
MOATA_ENABLE_DOCS=true                 # false in production: hides /docs and /openapi.json
MOATA_ALLOW_GUEST_AUTH=true            # temporary guest auth: closed demo/test environments only
MOATA_TOKEN_TTL_DAYS=30
MOATA_RETENTION_DAYS=90                # `python -m app.purge` deletes older trips
MOATA_XP_PER_VERIFIED_TRIP=10

# passenger-web/.env.local
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
